# ─── LND Dropper Configuration ──────────────────────────────────────────────

# Port (default: 4200)
LND_PORT=4200

# ─── Authentication (optional) ──────────────────────────────────────────────
# Set both LND_USER and LND_PASSWORD to enable authentication.
# Leave both empty to disable authentication.
LND_USER=admin
LND_PASSWORD=your-secure-password-here

# ─── Debug Mode (optional) ──────────────────────────────────────────────────
# Set to "true" or "1" to enable verbose debug logging
LND_DEBUG=false